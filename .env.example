# Intelligent Business Assistant Platform - Environment Configuration Template
# Copy this file to .env (or backend/.env) and update the values with secure secrets for your environment.
# DO NOT commit real secrets or credentials to version control.

# Application & Environment Mode
# Options: development, staging, production, test
ENV=development
LOG_LEVEL=INFO
APP_NAME="Intelligent Business Assistant"

# Database Configuration
# Default: Local SQLite database for rapid local development
DATABASE_URL=sqlite:///./data/dev.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql+psycopg2://<db_user>:<db_password>@<db_host>:5432/<db_name>

# Security & JWT Authentication
# IMPORTANT: Generate a strong, cryptographically secure random key for production:
# e.g., run `openssl rand -hex 32` or `python -c "import secrets; print(secrets.token_hex(32))"`
SECRET_KEY=generate-a-secure-random-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins
# Comma-separated list of allowed frontend origins. Never use "*" when credentials are supported.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Redis Cache & Message Broker (Optional for local dev, recommended for production rate limiting & queues)
REDIS_URL=redis://localhost:6379/0

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# LLM Providers Configuration
# Set valid API keys when interacting with AI agent workflows
OPENROUTER_KEY=your-openrouter-key-here
OPENROUTER_URL=https://api.openrouter.ai
DEEPSEEK_API_KEY=your-deepseek-key-here
DEEPSEEK_URL=https://api.deepseek.ai

# Provider Preferences (comma-separated list, e.g. openrouter,deepseek)
MODEL_PREFERENCES=openrouter,deepseek
LLM_DEFAULT_PROVIDER=openrouter

# Vector Database (Chroma)
CHROMA_DIR=./data/vector_db/chroma
CHROMA_API_KEY=
EMBEDDING_MODEL=deeps-embed-1

# Initial Seed Credentials (used only by seeding scripts in development)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=generate-secure-admin-password
TEST_EMAIL=user@example.com
TEST_PASSWORD=generate-secure-test-password
